<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Context Budgeting & Compactor</title>
  <style>
    :root { --bg: #090d16; --card: #111827; --border: #1e293b; --text: #f8fafc; --muted: #94a3b8; --accent: #38bdf8; }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: monospace; }
    body { background: var(--bg); color: var(--text); padding: 20px; max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
    h1 { color: var(--accent); font-size: 1.4rem; }
    textarea { width: 100%; height: 200px; background: var(--card); border: 1px solid var(--border); color: var(--text); padding: 12px; border-radius: 8px; resize: vertical; }
    .controls { display: flex; gap: 12px; align-items: center; }
    button { background: var(--accent); color: #000; border: none; padding: 10px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; }
    .stats { display: flex; gap: 20px; font-size: 0.9rem; color: var(--muted); }
  </style>
</head>
<body>
  <h1>Context Budgeting & Compactor</h1>
  <p style="color:var(--muted)">Paste long conversational context to measure tokens and prune filler text.</p>
  <textarea id="input" placeholder="Paste context here..."></textarea>
  <div class="controls">
    <button onclick="compact()">Compact Context</button>
    <div class="stats">
      <span>Original Tokens ~<strong id="origTokens">0</strong></span>
      <span>Compacted Tokens ~<strong id="compTokens">0</strong></span>
    </div>
  </div>
  <textarea id="output" placeholder="Compacted output appears here..." readonly></textarea>
  <script>
    function countTokens(str) { return Math.ceil(str.trim().split(/\s+/).filter(Boolean).length * 1.3); }
    function compact() {
      const raw = document.getElementById('input').value;
      document.getElementById('origTokens').innerText = countTokens(raw);
      const cleaned = raw.split('\n')
        .map(l => l.trim())
        .filter(l => l.length > 0 && !l.startsWith('//') && !l.toLowerCase().includes('thanks'))
        .join('\n');
      document.getElementById('output').value = cleaned;
      document.getElementById('compTokens').innerText = countTokens(cleaned);
    }
  </script>
</body>
</html>
