<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Context Budgeting & Compactor</title>
  <style>
    :root {
      --bg: #090d16;
      --card: #111827;
      --border: #1e293b;
      --border-focus: #38bdf8;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.15);
      --danger: #f43f5e;
      --success: #34d399;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding: 24px; min-height: 100vh; display: flex; flex-direction: column; gap: 20px; max-width: 1200px; margin: 0 auto; }

    header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 16px; }
    header h1 { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.01em; }
    .back-link { color: var(--accent); text-decoration: none; font-size: 0.85rem; font-weight: 600; }

    .meter-container { height: 10px; background: var(--card); border-radius: 6px; overflow: hidden; border: 1px solid var(--border); }
    .meter-bar { height: 100%; width: 0%; background: var(--success); transition: width 0.3s, background 0.3s; }

    .controls-bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; background: var(--card); padding: 14px 18px; border-radius: 10px; border: 1px solid var(--border); }
    .control-group { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--muted); }
    
    select, input[type="number"] { background: var(--bg); color: var(--text); border: 1px solid var(--border); padding: 6px 10px; border-radius: 6px; outline: none; font-size: 0.85rem; }
    
    button { background: var(--accent); color: #000; border: none; padding: 8px 18px; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: opacity 0.2s; }
    button:hover { opacity: 0.9; }

    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    @media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }

    .panel { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .panel h2 { font-size: 0.95rem; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }

    textarea { background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 14px; border-radius: 8px; font-family: monospace; font-size: 0.85rem; min-height: 380px; resize: vertical; outline: none; line-height: 1.5; }
    textarea:focus { border-color: var(--border-focus); }

    .stat-badge { background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border); color: var(--accent); font-family: monospace; }
  </style>
</head>
<body>

  <header>
    <h1>Context Budgeting & Compactor</h1>
    <a href="../tool-suite/index.html" class="back-link">&larr; Back to Suite Hub</a>
  </header>

  <div class="meter-container">
    <div id="meterBar" class="meter-bar"></div>
  </div>

  <div class="controls-bar">
    <div class="control-group">
      <label for="windowLimit">Context Limit:</label>
      <select id="windowLimit" onchange="updateStats()">
        <option value="4000">4,000 tokens</option>
        <option value="8000" selected>8,000 tokens</option>
        <option value="32000">32,000 tokens</option>
        <option value="128000">128,000 tokens</option>
      </select>
    </div>

    <div class="control-group">
      <label for="compactionStrategy">Strategy:</label>
      <select id="compactionStrategy">
        <option value="sliding-window">Preserve System Prompt + Recent turns</option>
        <option value="hand-off">Structured State Hand-off (Lossless state)</option>
      </select>
    </div>

    <button onclick="compactContext()">Compact Context</button>
  </div>

  <div class="grid">
    <div class="panel">
      <h2>Raw Input Context <span id="inputTokens" class="stat-badge">0 tokens</span></h2>
      <textarea id="rawInput" placeholder="Paste full multi-turn conversation logs, system instructions, or raw outputs here..." oninput="updateStats()"></textarea>
    </div>

    <div class="panel">
      <h2>Compacted Output Context <span id="outputTokens" class="stat-badge">0 tokens</span></h2>
      <textarea id="compactedOutput" readonly placeholder="Compacted context ready for LLM consumption will be rendered here..."></textarea>
    </div>
  </div>

  <script>
    function estimateTokens(text) {
      if (!text || !text.trim()) return 0;
      return Math.ceil(text.trim().split(/\s+/).length * 1.3);
    }

    function updateStats() {
      const input = document.getElementById('rawInput').value;
      const inputTok = estimateTokens(input);
      const limit = parseInt(document.getElementById('windowLimit').value, 10);

      document.getElementById('inputTokens').textContent = `${inputTok.toLocaleString()} tokens`;

      const pct = Math.min((inputTok / limit) * 100, 100);
      const meter = document.getElementById('meterBar');
      meter.style.width = `${pct}%`;
      meter.style.background = pct > 85 ? 'var(--danger)' : 'var(--success)';
    }

    function compactContext() {
      const input = document.getElementById('rawInput').value;
      if (!input.trim()) return;

      const strategy = document.getElementById('compactionStrategy').value;
      const lines = input.split('\n').filter(l => l.trim() !== '');

      let compacted = '';

      if (strategy === 'sliding-window') {
        const systemHeader = lines.slice(0, 3).join('\n');
        const recentTurns = lines.slice(-12).join('\n');
        compacted = `[SYSTEM INSTRUCTIONS & INITIAL STATE]\n${systemHeader}\n\n[TRUNCATED INTERMEDIATE TRACE NOISE]\n... (${lines.length - 15} lines pruned) ...\n\n[RECENT EXECUTION SLIDING WINDOW]\n${recentTurns}`;
      } else {
        const stateKeys = lines.filter(l => l.includes(':') || l.includes('=')).slice(0, 10).join('\n');
        compacted = `[COMPACT STATE HAND-OFF PAYLOAD]\n${stateKeys}\n\n[ACTIVE TASKS]\n${lines.slice(-4).join('\n')}`;
      }

      document.getElementById('compactedOutput').value = compacted;
      const outTok = estimateTokens(compacted);
      document.getElementById('outputTokens').textContent = `${outTok.toLocaleString()} tokens`;
    }
  </script>
</body>
</html>
